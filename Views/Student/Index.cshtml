@model IEnumerable<StudentRegistration.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="student-list-page">

    <form asp-action="Index" method="get" class="search-form">

        <div class="search-box">

            <span class="search-icon">⌕</span>

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   placeholder="Search students..." />

        </div>

        <button type="submit" class="search-btn">
            Search
        </button>

        @if (!string.IsNullOrWhiteSpace(ViewBag.Search))
        {
            <a asp-action="Index" class="clear-search">
                Clear
            </a>
        }

    </form>

    <div class="list-header">

        <div>
            <span class="eyebrow">STUDENT PORTAL</span>

            <h1>Students</h1>

            <p>
                Manage all registered students.
            </p>
        </div>

        <a asp-action="Create" class="add-btn">
            + Add Student
        </a>

    </div>


    <div class="student-table-card">

        @if (!Model.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    🎓
                </div>

                <h2>No Students Yet</h2>

                <p>
                    Start by registering your first student.
                </p>

                <a asp-action="Create" class="add-btn">
                    Register Student
                </a>

            </div>
        }
        else
        {
            <div class="table-wrapper">

                <table class="student-table">

                    <thead>
                        <tr>
                            <th>Student ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Course</th>
                            <th>Semester</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var student in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @student.StudentId
                                    </strong>
                                </td>

                                <td>
                                    @student.FirstName
                                    @student.LastName
                                </td>

                                <td>
                                    @student.Email
                                </td>

                                <td>
                                    @student.Phone
                                </td>

                                <td>
                                    @student.Course
                                </td>

                                <td>
                                    <span class="semester-badge">
                                        @student.Semester
                                    </span>
                                </td>
                                <td class="action-cell">

                                    <a asp-action="Details"
                                       asp-route-id="@student.Id"
                                       class="table-action view-action">
                                        View
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@student.Id"
                                       class="table-action edit-action">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@student.Id"
                                       class="table-action delete-action">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>