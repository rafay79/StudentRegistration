@model StudentRegistration.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="details-page">

    <div class="details-header">

        <div>
            <span class="eyebrow">STUDENT PROFILE</span>

            <h1>Student Details</h1>

            <p>
                Complete information about this student.
            </p>
        </div>

        <div class="details-actions">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="edit-btn">
                Edit Student
            </a>

            <a asp-action="Index"
               class="back-btn">
                Back
            </a>

        </div>

    </div>


    <div class="details-card">

        <div class="profile-header">

            <div class="profile-avatar">
                @Model.FirstName.Substring(0, 1).ToUpper()
            </div>

            <div>
                <h2>
                    @Model.FirstName @Model.LastName
                </h2>

                <p>
                    @Model.StudentId
                </p>
            </div>

        </div>


        <div class="details-section">

            <h3>Personal Information</h3>

            <div class="details-grid">

                <div class="detail-item">
                    <span>First Name</span>
                    <strong>@Model.FirstName</strong>
                </div>

                <div class="detail-item">
                    <span>Last Name</span>
                    <strong>@Model.LastName</strong>
                </div>

                <div class="detail-item">
                    <span>Email</span>
                    <strong>@Model.Email</strong>
                </div>

                <div class="detail-item">
                    <span>Phone</span>
                    <strong>@Model.Phone</strong>
                </div>

                <div class="detail-item">
                    <span>Date of Birth</span>
                    <strong>
                        @Model.DateOfBirth.ToString("dd MMM yyyy")
                    </strong>
                </div>

                <div class="detail-item">
                    <span>Gender</span>
                    <strong>@Model.Gender</strong>
                </div>

            </div>

        </div>


        <div class="details-section">

            <h3>Academic Information</h3>

            <div class="details-grid">

                <div class="detail-item">
                    <span>Student ID</span>
                    <strong>@Model.StudentId</strong>
                </div>

                <div class="detail-item">
                    <span>Course</span>
                    <strong>@Model.Course</strong>
                </div>

                <div class="detail-item">
                    <span>Semester</span>
                    <strong>@Model.Semester</strong>
                </div>

                <div class="detail-item">
                    <span>Enrollment Date</span>
                    <strong>
                        @Model.EnrollmentDate.ToString("dd MMM yyyy")
                    </strong>
                </div>

                <div class="detail-item">
                    <span>Previous Education</span>
                    <strong>@Model.PreviousEducation</strong>
                </div>

                <div class="detail-item">
                    <span>Skills</span>
                    <strong>@Model.Skills</strong>
                </div>

            </div>

        </div>


        <div class="details-section">

            <h3>Address</h3>

            <div class="details-grid">

                <div class="detail-item full">
                    <span>Address</span>
                    <strong>@Model.Address</strong>
                </div>

                <div class="detail-item">
                    <span>City</span>
                    <strong>@Model.City</strong>
                </div>

                <div class="detail-item">
                    <span>Country</span>
                    <strong>@Model.Country</strong>
                </div>

                <div class="detail-item">
                    <span>Postal Code</span>
                    <strong>@Model.PostalCode</strong>
                </div>

            </div>

        </div>


        <div class="details-section">

            <h3>About Student</h3>

            <p class="about-text">
                @Model.AboutStudent
            </p>

        </div>

    </div>

</div>